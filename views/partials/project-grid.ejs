<div class="work-grid">
  <% projects.forEach(function (p, i) { %>
    <a href="/<%= p.slug %>" class="work-card reveal" style="--d: <%= (i % 2) * 80 %>ms">
      <div class="work-card__media">
        <img src="<%= p.thumb %>" alt="<%= p.name %> — project cover" loading="lazy"<% if (p.thumbPosition) { %> style="object-position: <%= p.thumbPosition %>"<% } %>>
      </div>
      <div class="work-card__label">
        <span><%= p.cardTitle %></span>
        <%- include('icon', { name: 'arrow', size: 16 }) %>
      </div>
    </a>
  <% }) %>
</div>
